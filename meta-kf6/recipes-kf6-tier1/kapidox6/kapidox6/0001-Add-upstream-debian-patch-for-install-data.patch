From 79c367fbdd1535ba485bf18393e580aee88710c8 Mon Sep 17 00:00:00 2001
From: jmills <josephjamesmills@gmail.com>
Date: Thu, 26 Nov 2026 13:09:19 -0600
Subject: [PATCH] Add upstream debian patch for install data

see also https://salsa.debian.org/qt-kde-team/kde/kf6-kapidox/-/blob/master/debian/patches/fix-data-not-installed?ref_type=heads

Upstream-Status: Inappropriate [OE-specific]
---
 MANIFEST.in | 1 +
 setup.py    | 1 +
 2 files changed, 2 insertions(+)
 create mode 100644 MANIFEST.in

diff --git a/MANIFEST.in b/MANIFEST.in
new file mode 100644
index 0000000..c38095f
--- /dev/null
+++ b/MANIFEST.in
@@ -0,0 +1 @@
+recursive-include kapidox/data *
diff --git a/setup.py b/setup.py
index 821ecac..fdc10d6 100755
--- a/setup.py
+++ b/setup.py
@@ -8,6 +8,7 @@ setup(
         maintainer_email='olivier@churlaud.com',
         url='https://invent.kde.org/frameworks/kapidox',
         packages=find_packages(),
+        include_package_data=True,
         python_requires=">=3.8",
         scripts=['kapidox/depdiagram_generate_all'],
         entry_points={
-- 
