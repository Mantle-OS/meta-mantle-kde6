Subject: [PATCH] double path when cross compile

Signed-off-by: JosephMillsAtWork <josephjamesmills@gmail.com>
---
 KF6AuthConfig.cmake.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/KF6AuthConfig.cmake.in b/KF6AuthConfig.cmake.in
index d7fb222..fec4656 100644
--- a/KF6AuthConfig.cmake.in
+++ b/KF6AuthConfig.cmake.in
@@ -33,7 +33,7 @@ include("${CMAKE_CURRENT_LIST_DIR}/KF6AuthMacros.cmake")
 
 if(NOT "${KAUTH_BACKEND_NAME}" STREQUAL "FAKE")
     if(CMAKE_CROSSCOMPILING AND KF6_HOST_TOOLING)
-        find_file(KAUTH_TARGETSFILE KF6Auth/KF6AuthToolsTargets.cmake PATHS ${KF6_HOST_TOOLING} ${CMAKE_CURRENT_LIST_DIR} NO_DEFAULT_PATH)
+        find_file(KAUTH_TARGETSFILE KF6AuthToolsTargets.cmake PATHS ${KF6_HOST_TOOLING} ${CMAKE_CURRENT_LIST_DIR} NO_DEFAULT_PATH)
         include("${KAUTH_TARGETSFILE}")
     else()
         include("${CMAKE_CURRENT_LIST_DIR}/KF6AuthToolsTargets.cmake")
