Subject: [PATCH] add shared rust c lib and also rlib to crate type

Signed-off-by: JosephMillsAtWork <josephjamesmills@gmail.com>
---
 src/rs/adblock/Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/rs/adblock/Cargo.toml b/src/rs/adblock/Cargo.toml
index 89658a6..5fe267a 100644
--- a/src/rs/adblock/Cargo.toml
+++ b/src/rs/adblock/Cargo.toml
@@ -9,7 +9,7 @@ authors = ["Jonah Brüchert <jbb.prv@gmx.de>"]
 edition = "2018"
 
 [lib]
-crate-type = ["staticlib"]
+crate-type = ["cdylib", "rlib", "staticlib"]
 # See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html
 
 [build-dependencies]
